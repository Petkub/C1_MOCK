{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Judge this problem",
      "detail": "Ctrl+Shift+B (Cmd+Shift+B on Mac) while editing e.g. Mock_3/5.cpp",
      "type": "process",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["${workspaceFolder}/Judge/judge.py", "${fileBasename}"],
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Judge whole set",
      "detail": "judge 1.cpp ... 8.cpp of the set you are editing",
      "type": "process",
      "command": "python3",
      "windows": { "command": "python" },
      "args": ["${workspaceFolder}/Judge/judge.py"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
